diff --git a/net/minecraft/server/commands/SaveAllCommand.java b/net/minecraft/server/commands/SaveAllCommand.java
index 99ccc3971eb39a40074957d7833b7ce11fd7e602..7e27b3d4c589aab475ed90671d39406573574b71 100644
--- a/net/minecraft/server/commands/SaveAllCommand.java
+++ b/net/minecraft/server/commands/SaveAllCommand.java
@@ -23,6 +23,12 @@ public class SaveAllCommand {
 
     private static int saveAll(final CommandSourceStack source, final boolean flush) throws CommandSyntaxException {
         source.sendSuccess(() -> Component.translatable("commands.save.saving"), false);
+        MinecraftServer server = source.getServer();
+        boolean success = server.saveEverything(true, flush, true);
+        if (!success) {
+            throw ERROR_FAILED.create();
+        }
+        // Link: worlds are vanilla files (saved above); player data is committed by the ordered Link checkpoint.
         if (io.linkmc.server.NativeJournal.enabled()) {
             io.linkmc.server.NativeJournal.saveAsync().whenComplete((ignored, error) -> {
                 if (error == null) source.sendSuccess(() -> Component.translatable("commands.save.success"), true);
@@ -30,11 +36,6 @@ public class SaveAllCommand {
             });
             return Command.SINGLE_SUCCESS;
         }
-        MinecraftServer server = source.getServer();
-        boolean success = server.saveEverything(true, flush, true);
-        if (!success) {
-            throw ERROR_FAILED.create();
-        }
 
         source.sendSuccess(() -> Component.translatable("commands.save.success"), true);
         return Command.SINGLE_SUCCESS;
diff --git a/net/minecraft/server/network/config/PrepareSpawnTask.java b/net/minecraft/server/network/config/PrepareSpawnTask.java
index 9dcc19dc9a271cf640cdab384e86dd609dd46a53..08d59577656d56eb4b17dd37bd16df6f80fe724f 100644
--- a/net/minecraft/server/network/config/PrepareSpawnTask.java
+++ b/net/minecraft/server/network/config/PrepareSpawnTask.java
@@ -126,8 +126,9 @@ public class PrepareSpawnTask implements ConfigurationTask {
                 .orElseGet(() -> PlayerSpawnFinder.findSpawn(finalSpawnLevel, respawnData.pos()));
             // Paper end - move logic in Entity to here, to use bukkit supplied world UUID & reset to main world spawn if no valid world is found
             Vec2 spawnAngle = loadedPosition.rotation().orElse(new Vec2(respawnData.yaw(), respawnData.pitch()));
-            if (io.linkmc.server.NativeJournal.enabled()) {
-                var destination = io.linkmc.server.NativeJournal.destination(this.nameAndId.id());
+            // Link: only an explicit cross-server destination overrides vanilla placement (saved position / world spawn).
+            var destination = io.linkmc.server.NativeJournal.enabled() ? io.linkmc.server.NativeJournal.destination(this.nameAndId.id()) : null;
+            if (destination != null) {
                 var target = org.bukkit.Bukkit.getWorld(destination.world());
                 if (target == null) throw new IllegalStateException("Reserved Link world is not ready");
                 spawnLevel = ((org.bukkit.craftbukkit.CraftWorld) target).getHandle();
@@ -264,8 +265,8 @@ public class PrepareSpawnTask implements ConfigurationTask {
                     this.spawnAngle = new Vec2(location.getYaw(), location.getPitch());
                 }
                 // Paper end - PlayerSpawnLocationEvent
-                if (io.linkmc.server.NativeJournal.enabled()) {
-                    var destination = io.linkmc.server.NativeJournal.destination(PrepareSpawnTask.this.nameAndId.id());
+                var destination = io.linkmc.server.NativeJournal.enabled() ? io.linkmc.server.NativeJournal.destination(PrepareSpawnTask.this.nameAndId.id()) : null;
+                if (destination != null) {
                     this.spawnLevel = ((org.bukkit.craftbukkit.CraftWorld) java.util.Objects.requireNonNull(org.bukkit.Bukkit.getWorld(destination.world()), "Reserved world unavailable")).getHandle();
                     spawnPosition = new Vec3(destination.x(), destination.y(), destination.z());
                     this.spawnPosition = CompletableFuture.completedFuture(spawnPosition);
diff --git a/net/minecraft/world/level/storage/LevelStorageSource.java b/net/minecraft/world/level/storage/LevelStorageSource.java
